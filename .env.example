# ================================================================
# TernantApp - Environment Configuration
# ================================================================
# This file contains all environment variables for the application.
# Copy this file to .env for development or .env.production for production.
#
# DEPLOYMENT PROFILES:
#   full-stack: Deploy ALL services (set DB_HOST=mysql, REDIS_HOST=redis)
#   apps-only:  Deploy only apps (set DB_HOST and REDIS_HOST to external servers)
#
# Usage:
#   cp .env.example .env                    # For development
#   cp .env.example .env.production         # For production
# ================================================================

# ================================
# DEPLOYMENT CONFIGURATION
# ================================
# Profile: full-stack | apps-only | infra
DEPLOY_PROFILE=full-stack

# Environment: development | production
NODE_ENV=development

# Build target: development | production
BUILD_TARGET=development

# Project name (used for volume naming)
PROJECT_NAME=ternantapp

# Network name
NETWORK_NAME=apartment_network

# ================================
# DATABASE CONFIGURATION (MySQL)
# ================================
# For full-stack: Use 'mysql' (Docker service name)
# For apps-only: Use your external MySQL server (e.g., db.example.com)
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=apartment_management
DB_USERNAME=apartment_user
DB_PASSWORD=apartment_pass_dev

# MySQL root password (only needed for full-stack profile)
MYSQL_ROOT_PASSWORD=root_password_dev

# External MySQL port (host port mapping)
MYSQL_PORT=3307

# MySQL Docker settings (full-stack only)
MYSQL_VERSION=8.0
MYSQL_CONTAINER_NAME=apartment-mysql
MYSQL_MAX_CONNECTIONS=500
MYSQL_BUFFER_POOL_SIZE=1G
MYSQL_LOG_FILE_SIZE=256M

# Database connection pool
DB_POOL_SIZE=20
DB_POOL_ACQUIRE_TIMEOUT=30000
DB_POOL_IDLE_TIMEOUT=10000
DB_POOL_MAX_REUSES=100

# Database behavior
DB_TYPE=mysql
DB_LOGGING=true
DB_SYNCHRONIZE=false
DB_RUN_MIGRATIONS=true
DB_MIGRATIONS_RUN=false

# ================================
# REDIS CONFIGURATION
# ================================
# For full-stack: Use 'redis' (Docker service name)
# For apps-only: Use your external Redis server (e.g., redis.example.com)
REDIS_HOST=redis
REDIS_PORT_INTERNAL=6379
REDIS_PORT_EXTERNAL=6380
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=3600

# Redis Docker settings (full-stack only)
REDIS_VERSION=7-alpine
REDIS_CONTAINER_NAME=apartment-redis

# ================================
# BACKEND CONFIGURATION
# ================================
BACKEND_CONTAINER_NAME=apartment-backend
BACKEND_PORT=3000

# Application
API_PREFIX=api
APP_NAME=Apartment Management SaaS
BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001

# ================================
# FRONTEND CONFIGURATION
# ================================
FRONTEND_CONTAINER_NAME=apartment-frontend
FRONTEND_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# ================================
# JWT AUTHENTICATION
# ================================
# IMPORTANT: Generate secure secrets for production!
# Use: openssl rand -base64 48
JWT_SECRET=INSECURE_DEV_SECRET_CHANGE_ME_IN_PRODUCTION
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=INSECURE_DEV_REFRESH_SECRET_CHANGE_ME_IN_PRODUCTION
JWT_REFRESH_EXPIRES_IN=7d

# Session Management
SESSION_PREFIX=session:
SESSION_TTL=900
REFRESH_SESSION_PREFIX=refresh:
REFRESH_SESSION_TTL=604800

# ================================
# EMAIL CONFIGURATION
# ================================
# Providers: mailpit (dev), brevo, sendgrid, gmail
MAIL_PROVIDER=mailpit
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM_NAME=Apartment Management
MAIL_FROM_EMAIL=noreply@apartment.app

# Mailpit Docker settings (full-stack only)
MAILPIT_VERSION=latest
MAILPIT_CONTAINER_NAME=apartment-mailpit
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
MAILPIT_MAX_MESSAGES=5000

# ================================
# QUEUE CONFIGURATION (BullMQ)
# ================================
QUEUE_REDIS_HOST=redis
QUEUE_REDIS_PORT=6379
QUEUE_REDIS_PASSWORD=
QUEUE_REDIS_DB=1
QUEUE_JOB_ATTEMPTS=3
QUEUE_JOB_BACKOFF_DELAY=60000
QUEUE_COMPLETED_JOB_AGE=86400
QUEUE_FAILED_JOB_AGE=604800

# ================================
# REMINDER CONFIGURATION
# ================================
REMINDER_DUE_SOON_DAYS=3
REMINDER_DUE_SOON_CRON=0 8 * * *
REMINDER_OVERDUE_CRON=0 9 * * *
REMINDER_OVERDUE_INTERVAL_DAYS=7
REMINDER_MAX_RETRIES=3

# ================================
# SECURITY CONFIGURATION
# ================================
CORS_ORIGINS=http://localhost:3001,http://frontend:3001
CSRF_ENABLED=true
HELMET_ENABLED=true

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ================================
# FEATURE FLAGS
# ================================
FEATURE_TENANT_PORTAL=true
FEATURE_FILE_UPLOAD=true
FEATURE_AUDIT_LOG=true
FEATURE_QUEUE_ENABLED=true
AUTO_UPDATE_OCCUPANCY_STATUS=true

# ================================
# ADMIN TOOLS (Optional)
# ================================
# phpMyAdmin
PHPMYADMIN_VERSION=latest
PHPMYADMIN_CONTAINER_NAME=apartment-phpmyadmin
PHPMYADMIN_PORT=8082
PHPMYADMIN_UPLOAD_LIMIT=100M

# Redis Commander
REDIS_COMMANDER_VERSION=latest
REDIS_COMMANDER_CONTAINER_NAME=apartment-redis-commander
REDIS_COMMANDER_PORT=8081

# ================================
# MONITORING (Optional)
# ================================
HEALTH_CHECK_ENABLED=true
METRICS_ENABLED=true

# ================================
# BACKUP CONFIGURATION
# ================================
BACKUP_DIR=./deploy/backups

# ================================================================
# EXTERNAL SERVICES EXAMPLE (apps-only profile)
# ================================================================
# Uncomment and configure these for apps-only deployment:
#
# # External MySQL (AWS RDS, DigitalOcean, etc.)
# DB_HOST=your-mysql-server.amazonaws.com
# DB_PORT=3306
# DB_DATABASE=ternantapp_production
# DB_USERNAME=your_db_user
# DB_PASSWORD=your_strong_password
#
# # External Redis (AWS ElastiCache, Redis Cloud, etc.)
# REDIS_HOST=your-redis-server.cache.amazonaws.com
# REDIS_PORT_INTERNAL=6379
# REDIS_PASSWORD=your_redis_password
#
# # External Email Service (Brevo, SendGrid, etc.)
# MAIL_PROVIDER=brevo
# MAIL_HOST=smtp-relay.brevo.com
# MAIL_PORT=587
# MAIL_USER=your-brevo-email@example.com
# MAIL_PASSWORD=your-brevo-api-key
# ================================================================
