<mjml>
  <mj-head>
    <mj-title>Payment Receipt</mj-title>
    <mj-attributes>
      <mj-all font-family="Arial, sans-serif" />
      <mj-text font-size="14px" color="#333333" line-height="20px" />
      <mj-section padding="20px" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f4f4f4">
    <!-- Header -->
    <mj-section background-color="#4299e1" padding="20px">
      <mj-column>
        <mj-text align="center" color="#ffffff" font-size="24px" font-weight="bold">
          Apartment Management
        </mj-text>
        <mj-text align="center" color="#ffffff" font-size="16px">
          Payment Receipt
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Content -->
    <mj-section background-color="#ffffff" padding="30px">
      <mj-column>
        <mj-text font-size="18px" font-weight="bold" color="#2d3748">
          Payment Received - Thank You!
        </mj-text>

        <mj-text>
          Dear {{tenantName}},
        </mj-text>

        <mj-text>
          We have successfully received your payment for <strong>Unit {{unitNumber}}</strong>. Thank you for your prompt payment!
        </mj-text>

        <mj-divider border-color="#e2e8f0" />

        <mj-text font-weight="bold">Payment Details:</mj-text>
        <mj-text>
          • Receipt Number: {{receiptNumber}}<br/>
          • Payment Date: {{paymentDate}}<br/>
          • Amount Paid: ${{amount}}<br/>
          • Payment Method: {{paymentMethod}}<br/>
          • Reference: {{reference}}
        </mj-text>

        <mj-divider border-color="#e2e8f0" />

        <mj-text font-weight="bold">Invoice Information:</mj-text>
        <mj-text>
          • Invoice Number: {{invoiceNumber}}<br/>
          • Unit: {{unitNumber}}<br/>
          • Invoice Total: ${{invoiceTotal}}<br/>
          • Amount Paid: ${{amount}}<br/>
          • Remaining Balance: ${{remainingBalance}}
        </mj-text>

        <mj-button href="{{receiptUrl}}" background-color="#4299e1" color="#ffffff">
          View Full Receipt
        </mj-button>

        <mj-text font-size="12px" color="#718096">
          Please keep this receipt for your records. If you have any questions about this payment, please contact us.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Footer -->
    <mj-section background-color="#e2e8f0" padding="20px">
      <mj-column>
        <mj-text align="center" font-size="12px" color="#718096">
          &copy; {{year}} Apartment Management. All rights reserved.
        </mj-text>
        <mj-text align="center" font-size="11px" color="#a0aec0">
          This is an automated message, please do not reply to this email.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
