# ================================================================
# Production Environment Configuration
# ================================================================
# SECURITY WARNING:
# - Never commit the actual .env.production file to version control
# - Generate strong, unique secrets for production
# - Use different secrets than development
# - Rotate secrets regularly
#
# Setup:
# 1. Copy this file: cp .env.production.example .env.production
# 2. Fill in all values (remove comments if needed)
# 3. Ensure file permissions: chmod 600 .env.production
# ================================================================

# ================================
# Node Environment
# ================================
NODE_ENV=production

# ================================
# Network Configuration
# ================================
# Docker network name for all services
NETWORK_NAME=apartment_network

# ================================
# Timezone Configuration
# ================================
# System timezone (e.g., UTC, America/New_York, Europe/London)
TIMEZONE=UTC

# ================================
# Docker Image Configuration
# ================================
# Build target (production or development)
BUILD_TARGET=production

# Build context (usually current directory)
BUILD_CONTEXT=.

# Image names
BACKEND_IMAGE=apartment-backend:latest
FRONTEND_IMAGE=apartment-frontend:latest

# Dockerfiles
BACKEND_DOCKERFILE=./backend/Dockerfile
FRONTEND_DOCKERFILE=./frontend/Dockerfile

# ================================
# Container Restart Policy
# ================================
# Options: no, always, on-failure, unless-stopped
RESTART_POLICY=always

# ================================
# MySQL Database Configuration
# ================================
# MySQL version
MYSQL_VERSION=8.0

# Container name
MYSQL_CONTAINER_NAME=apartment-mysql

# Database credentials
MYSQL_ROOT_PASSWORD=CHANGE_ME_strong_root_password_minimum_16_chars

# Application database
DATABASE_NAME=apartment_management
DATABASE_USER=apartment_user
DATABASE_PASSWORD=CHANGE_ME_strong_db_password_minimum_16_chars

# Database host and port (internal Docker network)
DATABASE_HOST=mysql
DATABASE_PORT=3306

# MySQL Performance Tuning
MYSQL_MAX_CONNECTIONS=1000
MYSQL_BUFFER_POOL_SIZE=2G
MYSQL_LOG_FILE_SIZE=512M
MYSQL_FLUSH_LOG=1

# MySQL Logging
MYSQL_SLOW_QUERY_LOG=1
MYSQL_LONG_QUERY_TIME=2

# MySQL Configuration Directory
MYSQL_CONFIG_DIR=./mysql/conf.d

# MySQL Volume Name
MYSQL_VOLUME_NAME=apartment_mysql_data

# MySQL Health Check Retries
MYSQL_HEALTH_RETRIES=30

# ================================
# Redis Cache Configuration
# ================================
# Redis version
REDIS_VERSION=7-alpine

# Container name
REDIS_CONTAINER_NAME=apartment-redis

# Redis password (REQUIRED for production)
REDIS_PASSWORD=CHANGE_ME_strong_redis_password_minimum_16_chars

# Redis host and port (internal Docker network)
REDIS_HOST=redis
REDIS_PORT=6379

# Redis database number for main cache
REDIS_DB=0

# Redis TTL (seconds)
REDIS_TTL=3600

# Redis Persistence
REDIS_APPENDONLY=yes
REDIS_APPENDFSYNC=everysec

# Redis Memory Management
REDIS_MAXMEMORY=2gb
REDIS_MAXMEMORY_POLICY=noeviction

# Redis Connection Settings
REDIS_TCP_KEEPALIVE=300
REDIS_TIMEOUT=0

# Redis Volume Name
REDIS_VOLUME_NAME=apartment_redis_data

# Redis Health Check Retries
REDIS_HEALTH_RETRIES=30

# ================================
# Backend API Configuration
# ================================
# Container name
BACKEND_CONTAINER_NAME=apartment-backend

# Internal port (not exposed outside Docker network)
BACKEND_INTERNAL_PORT=3000

# API Configuration
API_PREFIX=api
APP_NAME=Apartment Management System

# URLs
BASE_URL=https://your-domain.com
FRONTEND_URL=https://your-domain.com

# Database Configuration (inherits from MySQL section)
DB_TYPE=mysql
DB_LOGGING=false
DB_SYNCHRONIZE=false
DB_RUN_MIGRATIONS=true
DB_MIGRATIONS_RUN=false

# Database Connection Pool
DB_POOL_SIZE=10
DB_POOL_ACQUIRE_TIMEOUT=30000
DB_POOL_IDLE_TIMEOUT=10000
DB_POOL_MAX_REUSES=100

# JWT Authentication
# IMPORTANT: Generate strong secrets with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_generate_different_secret_openssl_rand_base64_48
JWT_REFRESH_EXPIRES_IN=7d

# Session Management
SESSION_PREFIX=sess:
SESSION_TTL=900
REFRESH_SESSION_PREFIX=refresh:
REFRESH_SESSION_TTL=604800

# Email Configuration (Brevo SMTP recommended)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-email@example.com
SMTP_PASS=your-brevo-api-key-or-smtp-password
SMTP_FROM_NAME=Apartment Management
SMTP_FROM_EMAIL=noreply@your-domain.com
SMTP_SECURE=false

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Queue Configuration (BullMQ using Redis)
QUEUE_REDIS_HOST=redis
QUEUE_REDIS_PORT=6379
QUEUE_REDIS_DB=1
QUEUE_JOB_ATTEMPTS=3
QUEUE_JOB_BACKOFF_DELAY=5000
QUEUE_COMPLETED_JOB_AGE=86400
QUEUE_FAILED_JOB_AGE=604800

# Reminder Configuration
REMINDER_DUE_SOON_DAYS=3
REMINDER_DUE_SOON_CRON=0 9 * * *
REMINDER_OVERDUE_CRON=0 10 * * *
REMINDER_OVERDUE_INTERVAL_DAYS=7
REMINDER_MAX_RETRIES=3

# Security
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com
CSRF_ENABLED=true
HELMET_ENABLED=true

# Feature Flags
FEATURE_TENANT_PORTAL=true
FEATURE_FILE_UPLOAD=true
FEATURE_AUDIT_LOG=true
FEATURE_QUEUE_ENABLED=true

# Monitoring
HEALTH_CHECK_ENABLED=true
METRICS_ENABLED=true

# Backend Volumes
BACKEND_LOGS_VOLUME_NAME=apartment_backend_logs
UPLOADS_VOLUME_NAME=apartment_uploads

# Backend Health Check Retries
BACKEND_HEALTH_RETRIES=60

# ================================
# Frontend Application Configuration
# ================================
# Container name
FRONTEND_CONTAINER_NAME=apartment-frontend

# Internal port (not exposed outside Docker network)
FRONTEND_INTERNAL_PORT=3001

# Frontend hostname
FRONTEND_HOSTNAME=0.0.0.0

# Public API URL (accessible from browser)
# IMPORTANT: Must be publicly accessible URL
NEXT_PUBLIC_API_URL=https://your-domain.com/api/v1

# Frontend Health Check Retries
FRONTEND_HEALTH_RETRIES=60

# ================================
# Health Check Configuration
# ================================
# Applied to all services
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=10s
HEALTH_CHECK_RETRIES=3
HEALTH_CHECK_START_PERIOD=60s

# ================================
# Logging Configuration
# ================================
# Applied to all services
LOG_DRIVER=json-file
LOG_MAX_SIZE=10m
LOG_MAX_FILE=5

# ================================
# Backup Configuration
# ================================
# Backup directory (bind mount)
BACKUP_DIR=./deploy/backups

# ================================
# SSL/TLS Configuration (Optional - for Nginx)
# ================================
# Your domain name
DOMAIN_NAME=your-domain.com
DOMAIN_EMAIL=admin@your-domain.com

# ================================
# Optional Services Configuration
# ================================
# Uncomment if deploying Nginx reverse proxy
# NGINX_CONTAINER_NAME=apartment-nginx

# Uncomment if deploying Certbot for SSL
# CERTBOT_CONTAINER_NAME=apartment-certbot

# Uncomment if deploying MySQL backup service
# MYSQL_BACKUP_CONTAINER_NAME=apartment-mysql-backup

# ================================
# Monitoring Stack Configuration (Optional)
# ================================
# Prometheus
# PROMETHEUS_CONTAINER_NAME=apartment-prometheus
# PROMETHEUS_PORT=9090

# Grafana
# GRAFANA_CONTAINER_NAME=apartment-grafana
# GRAFANA_PORT=3002
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=CHANGE_ME_strong_grafana_password

# Loki
# LOKI_CONTAINER_NAME=apartment-loki
# LOKI_PORT=3100

# Alertmanager
# ALERTMANAGER_CONTAINER_NAME=apartment-alertmanager
# ALERTMANAGER_PORT=9093

# ================================
# Development Tools (DO NOT USE IN PRODUCTION)
# ================================
# These are for development only
# PHPMYADMIN_CONTAINER_NAME=apartment-phpmyadmin
# PHPMYADMIN_PORT=8082
# REDIS_COMMANDER_CONTAINER_NAME=apartment-redis-commander
# REDIS_COMMANDER_PORT=8081

# ================================================================
# SECURITY CHECKLIST BEFORE DEPLOYMENT
# ================================================================
# [ ] Changed all "CHANGE_ME" values
# [ ] Generated strong JWT secrets (minimum 32 characters)
# [ ] Set strong MySQL root password (minimum 16 characters)
# [ ] Set strong database password (minimum 16 characters)
# [ ] Set strong Redis password (minimum 16 characters)
# [ ] Updated SMTP credentials with your email provider
# [ ] Updated domain names (BASE_URL, FRONTEND_URL, CORS_ORIGINS)
# [ ] Updated NEXT_PUBLIC_API_URL to your public domain
# [ ] Set file permissions: chmod 600 .env.production
# [ ] Never committed .env.production to git
# [ ] Documented secrets in password manager
# [ ] Set up secret rotation schedule
# ================================================================
