# ================================================================
# TernantApp - Production Environment Configuration
# ================================================================
# IMPORTANT: Replace ALL values marked with CHANGE_ME before deploying!
#
# DEPLOYMENT PROFILES:
#   full-stack: Deploy ALL services (MySQL, Redis, Backend, Frontend)
#   apps-only:  Deploy only applications (assumes external MySQL/Redis)
#
# Security Checklist:
#   [ ] All CHANGE_ME values replaced with real values
#   [ ] Strong passwords generated (16+ characters)
#   [ ] JWT secrets generated (64+ characters)
#   [ ] File permissions set to 600 (chmod 600 .env.production)
#   [ ] File excluded from git (.gitignore)
# ================================================================

# ================================
# DEPLOYMENT CONFIGURATION
# ================================
DEPLOY_PROFILE=full-stack
NODE_ENV=production
BUILD_TARGET=production
PROJECT_NAME=ternantapp
NETWORK_NAME=apartment_network

# ================================
# DATABASE CONFIGURATION (MySQL)
# ================================
# For full-stack: Use 'mysql' (Docker service name)
# For apps-only: Use your external MySQL server address
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=apartment_management
DB_USERNAME=apartment_user
DB_PASSWORD=CHANGE_ME_strong_password_minimum_16_chars

# MySQL root password (full-stack only)
MYSQL_ROOT_PASSWORD=CHANGE_ME_strong_root_password_minimum_16_chars

# External MySQL port (full-stack only)
MYSQL_PORT=3307

# MySQL Docker settings (full-stack only)
MYSQL_VERSION=8.0
MYSQL_CONTAINER_NAME=apartment-mysql
MYSQL_MAX_CONNECTIONS=1000
MYSQL_BUFFER_POOL_SIZE=2G
MYSQL_LOG_FILE_SIZE=512M

# Database connection pool
DB_POOL_SIZE=50
DB_POOL_ACQUIRE_TIMEOUT=30000
DB_POOL_IDLE_TIMEOUT=10000
DB_POOL_MAX_REUSES=100

# Database behavior
DB_TYPE=mysql
DB_LOGGING=false
DB_SYNCHRONIZE=false
DB_RUN_MIGRATIONS=true
DB_MIGRATIONS_RUN=false

# ================================
# REDIS CONFIGURATION
# ================================
# For full-stack: Use 'redis' (Docker service name)
# For apps-only: Use your external Redis server address
REDIS_HOST=redis
REDIS_PORT_INTERNAL=6379
REDIS_PORT_EXTERNAL=6380
REDIS_PASSWORD=CHANGE_ME_strong_redis_password
REDIS_DB=0
REDIS_TTL=3600

# Redis Docker settings (full-stack only)
REDIS_VERSION=7-alpine
REDIS_CONTAINER_NAME=apartment-redis

# ================================
# BACKEND CONFIGURATION
# ================================
BACKEND_CONTAINER_NAME=apartment-backend
BACKEND_PORT=3000

# Application URLs - CHANGE THESE to your actual domain
API_PREFIX=api
APP_NAME=Apartment Management SaaS
BASE_URL=https://api.yourdomain.com
FRONTEND_URL=https://yourdomain.com

# ================================
# FRONTEND CONFIGURATION
# ================================
FRONTEND_CONTAINER_NAME=apartment-frontend
FRONTEND_PORT=3001
NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api/v1

# ================================
# JWT AUTHENTICATION
# ================================
# IMPORTANT: Generate these with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_generate_different_secret
JWT_REFRESH_EXPIRES_IN=7d

# Session Management
SESSION_PREFIX=session:
SESSION_TTL=900
REFRESH_SESSION_PREFIX=refresh:
REFRESH_SESSION_TTL=604800

# ================================
# EMAIL CONFIGURATION
# ================================
# Production email provider (brevo, sendgrid, gmail)
MAIL_PROVIDER=brevo
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USER=CHANGE_ME_your_smtp_username
MAIL_PASSWORD=CHANGE_ME_your_smtp_password
MAIL_FROM_NAME=Apartment Management
MAIL_FROM_EMAIL=noreply@yourdomain.com

# ================================
# QUEUE CONFIGURATION (BullMQ)
# ================================
QUEUE_REDIS_HOST=redis
QUEUE_REDIS_PORT=6379
QUEUE_REDIS_PASSWORD=CHANGE_ME_same_as_redis_password
QUEUE_REDIS_DB=1
QUEUE_JOB_ATTEMPTS=3
QUEUE_JOB_BACKOFF_DELAY=60000
QUEUE_COMPLETED_JOB_AGE=86400
QUEUE_FAILED_JOB_AGE=604800

# ================================
# REMINDER CONFIGURATION
# ================================
REMINDER_DUE_SOON_DAYS=3
REMINDER_DUE_SOON_CRON=0 8 * * *
REMINDER_OVERDUE_CRON=0 9 * * *
REMINDER_OVERDUE_INTERVAL_DAYS=7
REMINDER_MAX_RETRIES=3

# ================================
# SECURITY CONFIGURATION
# ================================
# IMPORTANT: Update CORS_ORIGINS with your actual domain(s)
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CSRF_ENABLED=true
HELMET_ENABLED=true

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ================================
# FEATURE FLAGS
# ================================
FEATURE_TENANT_PORTAL=true
FEATURE_FILE_UPLOAD=true
FEATURE_AUDIT_LOG=true
FEATURE_QUEUE_ENABLED=true
AUTO_UPDATE_OCCUPANCY_STATUS=true

# ================================
# ADMIN TOOLS (Disabled in production by default)
# ================================
PHPMYADMIN_PORT=8082
REDIS_COMMANDER_PORT=8081

# ================================
# MONITORING
# ================================
HEALTH_CHECK_ENABLED=true
METRICS_ENABLED=true

# ================================
# BACKUP CONFIGURATION
# ================================
BACKUP_DIR=./deploy/backups

# ================================================================
# APPS-ONLY PROFILE EXAMPLE
# ================================================================
# For apps-only deployment with external MySQL and Redis:
#
# DB_HOST=your-mysql.rds.amazonaws.com
# DB_PORT=3306
# DB_DATABASE=ternantapp_prod
# DB_USERNAME=admin
# DB_PASSWORD=your_strong_mysql_password
#
# REDIS_HOST=your-redis.cache.amazonaws.com
# REDIS_PORT_INTERNAL=6379
# REDIS_PASSWORD=your_strong_redis_password
#
# Then deploy with: ./deploy.sh apps-only prod
# ================================================================
