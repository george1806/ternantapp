# Production Environment Configuration
# Auto-generated for deployment testing

# ================================
# Node Environment
# ================================
NODE_ENV=production

# ================================
# Network Configuration
# ================================
NETWORK_NAME=

# ================================
# Timezone Configuration
# ================================
TIMEZONE=UTC

# ================================
# Docker Image Configuration
# ================================
BUILD_TARGET=production
BUILD_CONTEXT=../..
BACKEND_IMAGE=apartment-backend:latest
FRONTEND_IMAGE=apartment-frontend:latest
BACKEND_DOCKERFILE=backend/Dockerfile
FRONTEND_DOCKERFILE=frontend/Dockerfile

# ================================
# Container Restart Policy
# ================================
RESTART_POLICY=always

# ================================
# MySQL Database Configuration
# ================================
MYSQL_VERSION=8.0
MYSQL_CONTAINER_NAME=apartment-mysql

# Database credentials
MYSQL_ROOT_PASSWORD=
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=

# Database host and port (internal Docker network)
DATABASE_HOST=mysql
DATABASE_PORT=3306

# MySQL Performance Tuning
MYSQL_MAX_CONNECTIONS=1000
MYSQL_BUFFER_POOL_SIZE=2G
MYSQL_LOG_FILE_SIZE=512M
MYSQL_FLUSH_LOG=1

# MySQL Logging
MYSQL_SLOW_QUERY_LOG=1
MYSQL_LONG_QUERY_TIME=2

# MySQL Configuration Directory
MYSQL_CONFIG_DIR=./mysql/conf.d

# MySQL Volume Name
MYSQL_VOLUME_NAME=

# MySQL Health Check Retries
MYSQL_HEALTH_RETRIES=30

# ================================
# Redis Cache Configuration
# ================================
REDIS_VERSION=7-alpine
REDIS_CONTAINER_NAME=

# Redis password
REDIS_PASSWORD=

# Redis host and port (internal Docker network)
REDIS_HOST=
REDIS_PORT=

# Redis database number for main cache
REDIS_DB=0

# Redis TTL (seconds)
REDIS_TTL=3600

# Redis Persistence
REDIS_APPENDONLY=yes
REDIS_APPENDFSYNC=everysec

# Redis Memory Management
REDIS_MAXMEMORY=2gb
REDIS_MAXMEMORY_POLICY=

# Redis Connection Settings
REDIS_TCP_KEEPALIVE=300
REDIS_TIMEOUT=0

# Redis Volume Name
REDIS_VOLUME_NAME=

# Redis Health Check Retries
REDIS_HEALTH_RETRIES=30

# ================================
# Backend API Configuration
# ================================
BACKEND_CONTAINER_NAME=

# Port configuration
BACKEND_INTERNAL_PORT=3000
BACKEND_EXTERNAL_PORT=3000

# API Configuration
API_PREFIX=api
APP_NAME="Apartment Management System"

# URLs
BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001

# Database Configuration
DB_TYPE=mysql
DB_LOGGING=false
DB_SYNCHRONIZE=false
DB_RUN_MIGRATIONS=true
DB_MIGRATIONS_RUN=false

# Database Connection Pool
DB_POOL_SIZE=10
DB_POOL_ACQUIRE_TIMEOUT=30000
DB_POOL_IDLE_TIMEOUT=10000
DB_POOL_MAX_REUSES=100

# JWT Authentication
JWT_SECRET=
JWT_EXPIRES_IN=
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=

# Session Management
SESSION_PREFIX=sess:
SESSION_TTL=900
REFRESH_SESSION_PREFIX=refresh:
REFRESH_SESSION_TTL=604800

# Email Configuration (Brevo SMTP)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME="Apartment Management"
SMTP_FROM_EMAIL=
SMTP_SECURE=false

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Queue Configuration (BullMQ using Redis)
QUEUE_REDIS_HOST=redis
QUEUE_REDIS_PORT=6379
QUEUE_REDIS_DB=1
QUEUE_JOB_ATTEMPTS=3
QUEUE_JOB_BACKOFF_DELAY=5000
QUEUE_COMPLETED_JOB_AGE=86400
QUEUE_FAILED_JOB_AGE=604800

# Reminder Configuration
REMINDER_DUE_SOON_DAYS=3
REMINDER_DUE_SOON_CRON="0 9 * * *"
REMINDER_OVERDUE_CRON="0 10 * * *"
REMINDER_OVERDUE_INTERVAL_DAYS=7
REMINDER_MAX_RETRIES=3

# Security
CORS_ORIGINS=http://localhost:3002,http://localhost:3001,http://localhost:3000
CSRF_ENABLED=true
HELMET_ENABLED=true

# Feature Flags
FEATURE_TENANT_PORTAL=true
FEATURE_FILE_UPLOAD=true
FEATURE_AUDIT_LOG=true
FEATURE_QUEUE_ENABLED=true

# Monitoring
HEALTH_CHECK_ENABLED=true
METRICS_ENABLED=true

# Backend Volumes
BACKEND_LOGS_VOLUME_NAME=
UPLOADS_VOLUME_NAME=

# Backend Health Check Retries
BACKEND_HEALTH_RETRIES=60

# ================================
# Default Admin User Configuration
# ================================
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=
DEFAULT_ADMIN_FIRST_NAME=
DEFAULT_ADMIN_LAST_NAME=

# ================================
# Frontend Application Configuration
# ================================
FRONTEND_CONTAINER_NAME=

# Port configuration
FRONTEND_INTERNAL_PORT=
FRONTEND_EXTERNAL_PORT=

# Frontend hostname
FRONTEND_HOSTNAME=0.0.0.0

# Public API URL (accessible from browser)
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# Frontend Health Check Retries
FRONTEND_HEALTH_RETRIES=60

# ================================
# Health Check Configuration
# ================================
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=10s
HEALTH_CHECK_RETRIES=3
HEALTH_CHECK_START_PERIOD=60s

# ================================
# Logging Configuration
# ================================
LOG_DRIVER=json-file
LOG_MAX_SIZE=10m
LOG_MAX_FILE=5

# ================================
# Backup Configuration
# ================================
BACKUP_DIR=./deploy/backups

# Email Provider Configuration
MAIL_PROVIDER=brevo
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM_NAME=Apartment Management
MAIL_FROM_EMAIL=
