# ==========================================
# PRODUCTION ENVIRONMENT VARIABLES
# ==========================================
# Copy this file to .env.production and fill in your values
# NEVER commit .env.production to git!
# ==========================================

# ==========================================
# Application
# ==========================================
NODE_ENV=production
APP_NAME=Apartment Management System
BASE_URL=https://api.yourdomain.com
FRONTEND_URL=https://yourdomain.com

# ==========================================
# Docker Image Tags
# ==========================================
IMAGE_TAG=latest

# ==========================================
# Database (MySQL)
# ==========================================
DB_DATABASE=apartment_management
DB_USERNAME=apartment_user
# Passwords are in secrets files, not here!

# ==========================================
# API Configuration
# ==========================================
API_PREFIX=api
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ==========================================
# Email Provider
# ==========================================
# Options: brevo, sendgrid, ses, gmail
MAIL_PROVIDER=brevo
MAIL_USER=your-email@example.com
MAIL_FROM_NAME=Apartment Management
MAIL_FROM_EMAIL=noreply@yourdomain.com

# ==========================================
# Security
# ==========================================
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
THROTTLE_LIMIT=100

# ==========================================
# Backups
# ==========================================
BACKUP_RETAIN_DAYS=7
BACKUP_S3_BUCKET=your-backup-bucket
AWS_ACCESS_KEY_ID=your-aws-access-key

# ==========================================
# Monitoring & Logging
# ==========================================
GRAFANA_ROOT_URL=https://grafana.yourdomain.com
GRAFANA_ADMIN_USER=admin

# ==========================================
# API URLs
# ==========================================
NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api/v1

# ==========================================
# MySQL Monitoring
# ==========================================
MYSQL_EXPORTER_PASSWORD=exporter_password

# ==========================================
# Feature Flags
# ==========================================
DB_RUN_MIGRATIONS=true

# ==========================================
# SSL/Domain Configuration
# ==========================================
# Replace 'your-domain.com' with your actual domain in nginx.conf
DOMAIN=yourdomain.com
